# 무시할 파일 설정 안내: https://help.github.com/articles/ignoring-files/

# 의존성
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 테스트 결과
/coverage

# Next.js 생성 파일
/.next/
/.vinext/
/out/

# 기타 생성 파일
.DS_Store
*.pem

# 디버그 로그
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 환경 변수 파일(필요한 경우에만 버전 관리에 포함)
.env*

# Vercel 설정
.vercel

# TypeScript 생성 파일
next-env.d.ts
/dist/
/.wrangler/
# 현재 작업 폴더의 실행 환경과 도구 상태는 게시하지 않습니다.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/
